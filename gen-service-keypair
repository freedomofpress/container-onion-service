#!/bin/bash
# Utility script to generate a Tor v3 Onion Service,
# print its config (i.e. hostname & keypair) to stdout

set -e
set -u
set -o pipefail


tmp_torrc="$(mktemp)"
tor_log="$(mktemp)"
# Seconds to wait for tor to write the service files before giving up
timeout="${GEN_SERVICE_KEYPAIR_TIMEOUT:-60}"
onion_dir="/var/lib/tor/onion"
cat <<EOF > "$tmp_torrc"
HiddenServiceDir $onion_dir
HiddenServicePort 1234 127.0.0.1:1234
EOF


function fail() {
    # stdout is consumed by callers (e.g. eval), so report on stderr
    echo "ERROR: $1" >&2
    if [ -s "$tor_log" ]; then
        echo "tor output:" >&2
        cat "$tor_log" >&2
    fi
    exit 1
}

function wait_for_file() {
    local f
    f="$1"
    shift
    while ! test -f "$f"; do
        if ! kill -0 "$tor_pid" 2>/dev/null; then
            fail "tor exited before creating $f"
        fi
        if [ "$SECONDS" -ge "$timeout" ]; then
            fail "timed out after ${timeout}s waiting for $f"
        fi
        sleep 1
    done
}

# Start tor service, backgrounded, then wait for conf files.
# The tor process will create the necessary files when it starts.
nohup tor -f "$tmp_torrc" --hush > "$tor_log" 2>&1 &
tor_pid=$!
# Reap tor on exit, so the DataDirectory lock is free for the next tor process.
cleanup() { kill "$tor_pid" 2>/dev/null || true; wait "$tor_pid" || true; rm -f "$tmp_torrc" "$tor_log"; }
trap cleanup EXIT

for tor_file in hostname hs_ed25519_public_key hs_ed25519_secret_key ; do
    f="${onion_dir}/${tor_file}"
    wait_for_file "$f"
done

cat <<EOF
TOR_ONION_HOSTNAME=$(cat "${onion_dir}/hostname")
TOR_ONION_V3_PUBLIC_KEY=$(cat "${onion_dir}/hs_ed25519_public_key" | base64 -w 0)
TOR_ONION_V3_SECRET_KEY=$(cat "${onion_dir}/hs_ed25519_secret_key" | base64 -w 0)
EOF
